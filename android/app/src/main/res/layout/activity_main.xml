<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <!-- 顶部标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLIProxy API"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#F8FAFC"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="本地大模型全协议转换代理 · 移动端瘦身版"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="24dp" />

    <!-- 状态卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#334155"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#EF4444"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已停止"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEndpoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务地址: http://127.0.0.1:8317"
                android:textSize="13sp"
                android:textColor="#38BDF8"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvDataDir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据目录: 正在加载..."
                android:textSize="11sp"
                android:textColor="#64748B"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 操作按钮区 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="启动服务"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenWeb"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="打开管理控制台 (Web UI)"
        android:textSize="14sp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:strokeColor="#38BDF8"
        android:textColor="#38BDF8"
        app:cornerRadius="12dp"
        android:layout_marginBottom="24dp" />

    <!-- 运行信息卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#334155">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="核心能力保全特性"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 协议互转: OpenAI ⇄ Claude ⇄ Gemini ⇄ Codex\n• 自动更新: 模型目录与 Web UI 远端热拉取\n• 凭据轮询: 多账号自动轮转与 429 智能冷却\n• 架构优化: 剥离企业数据库/Redis/WebRTC 瘦身 70%"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#94A3B8" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
