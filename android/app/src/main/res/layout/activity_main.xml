<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLIProxy API"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本地大模型全协议转换代理 · 移动端瘦身版"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="20dp" />

        <!-- 状态卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/statusIndicator"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#EF4444"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="已停止"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F8FAFC" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEndpoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务地址: http://127.0.0.1:8317"
                    android:textSize="13sp"
                    android:textColor="#38BDF8"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvDataDir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据目录: 正在加载..."
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 认证与 API Key 卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 访问认证设置"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC" />

                <TextView
                    android:id="@+id/tvApiKeyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前: 免密模式 (浏览器与客户端可直接访问)"
                    android:textSize="13sp"
                    android:textColor="#34D399"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvApiKeyValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="无需 API Key"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="#94A3B8"
                    android:background="#0F172A"
                    android:padding="8dp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyKey"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="复制 Key"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleAuthMode"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1.2"
                        android:text="切换为免密访问"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="#38BDF8"
                        android:textColor="#38BDF8" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 操作按钮区 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="启动服务"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestModels"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="在浏览器查看模型"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="#38BDF8"
                android:textColor="#38BDF8"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestHealthz"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="健康检查 (healthz)"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="#94A3B8"
                android:textColor="#94A3B8"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenWeb"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="打开管理控制台 (Web UI)"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.TonalButton"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 运行信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="核心特性"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 协议互转: OpenAI ⇄ Claude ⇄ Gemini ⇄ Codex\n• 自动更新: 模型目录与 Web UI 远端热拉取\n• 智能降级: 恒定纯本地单机内存缓存\n• 状态栏操作: 常驻通知栏自带停止服务快捷键"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#94A3B8" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
